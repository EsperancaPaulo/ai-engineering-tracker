DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/ai_engineering_tracker
# Generate locally using the README instructions. Never commit the actual secret.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Real Cloudflare Turnstile widget; keep the secret only in your private .env.
TURNSTILE_MODE=required
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Optional, billed OpenAI API. Disabled until explicitly enabled and configured.
AI_SUGGESTIONS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# Optional Slack channel, bound to one project. Keep the webhook private.
SLACK_WEBHOOK_URL=
SLACK_PROJECT_ID=
SLACK_CHANNEL_LABEL=
SLACK_SENDING_ENABLED=false

# Optional TLS SMTP for verification/recovery links. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_PUBLIC_URL=http://127.0.0.1:8000

# Enable only after SMTP delivery and existing-account verification are tested.
REQUIRE_VERIFIED_EMAIL=false

# Optional read-only GitHub credential, limited to explicitly listed repositories/project.
GITHUB_READ_TOKEN=
GITHUB_PROJECT_ID=
GITHUB_ALLOWED_REPOSITORIES=
